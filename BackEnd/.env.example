# ============================================================================
# Tomar+Digital — Backend Environment Variables
# ============================================================================
# Copia este ficheiro para .env e preenche com os teus valores reais:
#   cp .env.example .env
#
# NUNCA faças commit do ficheiro .env — contém credenciais sensíveis.
# ============================================================================

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Porta onde o servidor Express vai correr (fallback: 8080)
PORT=8080

# ---------------------------------------------------------------------------
# Base de Dados (MongoDB)
# ---------------------------------------------------------------------------
# URI de ligação ao MongoDB.
# Local (Docker): mongodb://localhost:27017/tomar_db
# Produção (Atlas): mongodb+srv://utilizador:password@cluster.mongodb.net/tomar_db
MONGO_URI=mongodb://localhost:27017/tomar_db

# ---------------------------------------------------------------------------
# Segurança (JWT)
# ---------------------------------------------------------------------------
# Chave secreta usada para assinar os JWTs.
# Em produção, usa uma string aleatória forte (≥32 caracteres).
# Gera uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=substitui_por_uma_chave_aleatoria_forte

# ---------------------------------------------------------------------------
# Email (Gmail SMTP via Nodemailer)
# ---------------------------------------------------------------------------
# App Password do Gmail (NÃO é a password normal de login).
# Como obter:
#   1. Ativa a Verificação de 2 Passos em https://myaccount.google.com/security
#   2. Vai a "App Passwords" → https://myaccount.google.com/apppasswords
#   3. Gera uma password para "Mail"
#   4. Copia a password de 16 caracteres para aqui
#
# O remetente está hardcoded: tomardigitalsuporte@gmail.com
GOOGLE_APP_PASSWORD=sua_app_password_de_16_caracteres

# ---------------------------------------------------------------------------
# Azure Document Intelligence (OCR de Faturas)
# ---------------------------------------------------------------------------
# Usado para extrair dados de faturas portuguesas (QR Code AT).
# Como obter:
#   1. Vai a https://portal.azure.com/
#   2. Cria um recurso "Document Intelligence" (ou "Form Recognizer")
#   3. Seleciona o tier F0 (grátis, 500 páginas/mês) ou S0 (pay-as-you-go)
#   4. Copia o "Endpoint" e a "Key 1" para as variáveis abaixo
AZURE_VISION_ENDPOINT=https://seu-recurso.cognitiveservices.azure.com/
AZURE_VISION_KEY=sua_chave_azure_aqui
