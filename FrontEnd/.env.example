# ============================================================================
# Tomar+Digital — Frontend Environment Variables
# ============================================================================
# Copia este ficheiro para .env e preenche com os teus valores reais:
#   cp .env.example .env
#
# NUNCA faças commit do ficheiro .env.
# ============================================================================

# ---------------------------------------------------------------------------
# URL da API (Backend)
# ---------------------------------------------------------------------------
# URL do backend. Em desenvolvimento local, usa o IP do teu PC (não localhost).
#
# Como descobrir o teu IP local:
#   Linux/macOS:    ifconfig | grep "inet " | grep -v 127.0.0.1
#   Windows:        ipconfig → "Endereço IPv4"
#
# O telemóvel e o PC devem estar na MESMA rede Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080

# ---------------------------------------------------------------------------
# Google Maps API Key
# ---------------------------------------------------------------------------
# Chave da API do Google Maps (obrigatória para o mapa funcionar).
#
# Como obter:
#   1. Vai a https://console.cloud.google.com/
#   2. Cria um projeto (ou seleciona um existente)
#   3. Ativa as APIs: "Maps SDK for Android" e "Maps SDK for iOS"
#   4. Vai a "Credentials" → "Create Credentials" → "API Key"
#   5. Restringe a chave ao pacote Android: com.jlfernandes.TomarDigital
#   6. Copia a chave para a variável abaixo
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui
